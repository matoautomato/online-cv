<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{basics.name}} — {{basics.title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..700;1,14..32,400&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --color-text: #1a1a1a;
      --color-text-secondary: #4a4a4a;
      --color-text-light: #6a6a6a;
      --color-border: #d0d0d0;
      --color-border-light: #e8e8e8;
      --color-bg: #ffffff;
      --color-accent: #2a2a2a;
      --color-tag-bg: #f4f4f4;
      --color-tag-border: #ddd;
      --font-sans: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
      --page-max-width: 800px;
      --page-padding: 2rem;
    }

    html {
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body {
      font-family: var(--font-sans);
      color: var(--color-text);
      background: var(--color-bg);
      line-height: 1.6;
      max-width: var(--page-max-width);
      margin: 0 auto;
      padding: var(--page-padding);
    }

    /* Header */
    .cv-header {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 2px solid var(--color-accent);
    }

    .cv-header h1 {
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.2;
      margin-bottom: 0.25rem;
    }

    .cv-header .title {
      font-size: 1.15rem;
      font-weight: 400;
      color: var(--color-text-secondary);
      margin-bottom: 0.75rem;
    }

    .cv-header .contact {
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--color-text-light);
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem 0;
      letter-spacing: 0.01em;
    }

    .cv-header .contact span,
    .cv-header .contact a {
      white-space: nowrap;
    }

    .cv-header .contact span + span::before,
    .cv-header .contact span + a::before,
    .cv-header .contact a + span::before,
    .cv-header .contact a + a::before {
      content: "|";
      margin: 0 0.5rem;
      color: var(--color-border);
    }

    .cv-header .contact a {
      color: var(--color-text-light);
      text-decoration: none;
    }

    .cv-header .contact a:hover {
      color: var(--color-text);
    }

    /* Sections */
    .cv-section {
      margin-bottom: 1.9rem;
    }

    .cv-section h2 {
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-text);
      border-bottom: 1px solid var(--color-border);
      padding-bottom: 0.4rem;
      margin-bottom: 1rem;
    }

    /* Summary */
    .cv-summary p {
      color: var(--color-text-secondary);
      font-size: 0.95rem;
    }

    /* Competencies */
    .cv-competencies ul {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .cv-competencies li {
      font-size: 0.8rem;
      padding: 0.3rem 0.7rem;
      background: var(--color-tag-bg);
      border: 1px solid var(--color-tag-border);
      border-radius: 3px;
      color: var(--color-text-secondary);
    }

    /* Experience entries */
    .cv-entry {
      margin-bottom: 1.25rem;
    }

    .cv-entry:last-child {
      margin-bottom: 0;
    }

    .cv-entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
      margin-bottom: 0.3rem;
    }

    .cv-entry-header h3 {
      font-size: 0.95rem;
      font-weight: 600;
    }

    .cv-entry-header .dates {
      font-size: 0.8rem;
      color: var(--color-text-light);
      white-space: nowrap;
    }

    .cv-entry .subtitle {
      font-size: 0.8rem;
      font-style: italic;
      color: var(--color-text-light);
      margin-bottom: 0.35rem;
    }

    .cv-entry .entry-summary {
      font-size: 0.85rem;
      color: var(--color-text-secondary);
      margin-bottom: 0.5rem;
    }

    .cv-entry ul {
      list-style: disc;
      padding-left: 1.25rem;
    }

    .cv-entry li {
      font-size: 0.85rem;
      color: var(--color-text-secondary);
      margin-bottom: 0.15rem;
    }

    /* Achievements list */
    .cv-achievements ul {
      list-style: disc;
      padding-left: 1.25rem;
    }

    .cv-achievements li {
      font-size: 0.85rem;
      color: var(--color-text-secondary);
      margin-bottom: 0.25rem;
    }

    /* Education, Board Roles, Certs */
    .cv-simple-entry {
      margin-bottom: 0.6rem;
    }

    .cv-simple-entry:last-child {
      margin-bottom: 0;
    }

    .cv-simple-entry .main-line {
      font-size: 0.9rem;
      font-weight: 500;
    }

    .cv-simple-entry .detail-line {
      font-size: 0.8rem;
      color: var(--color-text-light);
    }

    /* Languages — inline */
    .cv-languages ul {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1.5rem;
    }

    .cv-languages li {
      font-size: 0.85rem;
      color: var(--color-text-secondary);
    }

    .cv-languages .level {
      color: var(--color-text-light);
    }

    /* Interests — inline like languages */
    .cv-interests ul {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1.5rem;
    }

    .cv-interests li {
      font-size: 0.85rem;
      color: var(--color-text-secondary);
    }

    /* Publications */
    .cv-publications .cv-entry ul {
      list-style: none;
      padding-left: 0;
    }

    /* Download button */
    .cv-download {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      background: var(--color-accent);
      color: #fff;
      border: none;
      padding: 0.6rem 1.2rem;
      font-size: 0.85rem;
      font-family: var(--font-sans);
      cursor: pointer;
      border-radius: 4px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.15);
      transition: background 0.2s;
    }

    .cv-download:hover {
      background: #000;
    }

    /* Print styles */
    @page {
      size: A4;
      margin: 12mm 12mm 12mm 12mm;
    }

    @media print {
      .cv-download {
        display: none;
      }

      html {
        font-size: 9.5pt;
      }

      body {
        padding: 0;
        max-width: none;
        line-height: 1.4;
      }

      .cv-header {
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
      }

      .cv-section {
        margin-bottom: 1.2rem;
      }

      .cv-entry {
        margin-bottom: 0.8rem;
      }

      /* Keep section headings with their content */
      .cv-section h2 {
        break-after: avoid;
      }

      /* Avoid breaking inside experience entries and simple entries */
      .cv-entry {
        break-inside: avoid;
      }

      .cv-simple-entry {
        break-inside: avoid;
      }

      /* Prefer page breaks between sections, not inside them */
      .cv-section {
        break-inside: auto;
      }

      /* Prevent orphan bullets */
      .cv-entry li {
        orphans: 2;
        widows: 2;
      }

      /* Ensure competency tags don't split across pages */
      .cv-competencies {
        break-inside: avoid;
      }

      /* Ensure links print as plain text */
      a {
        color: var(--color-text-light);
        text-decoration: none;
      }

      /* No background colors in print */
      .cv-competencies li {
        background: none;
        border-color: var(--color-border);
      }
    }
  </style>
</head>
<body>

  <header class="cv-header">
    <h1>{{basics.name}}</h1>
    <div class="title">{{basics.title}}</div>
    <div class="contact">
      {{#if basics.location}}<span>{{basics.location}}</span>{{/if}}
      {{#if basics.email}}<a href="mailto:{{basics.email}}">{{basics.email}}</a>{{/if}}
      {{#if basics.phone}}<span>{{basics.phone}}</span>{{/if}}
      {{#if basics.url}}<a href="https://{{basics.url}}">{{basics.url}}</a>{{/if}}
      {{#if basics.linkedin}}<a href="{{basics.linkedin}}">LinkedIn</a>{{/if}}
    </div>
  </header>

  <main>
    {{#if basics.summary}}
    <section class="cv-section cv-summary">
      <h2>Executive Summary</h2>
      <p>{{basics.summary}}</p>
    </section>
    {{/if}}

    {{#if competencies}}
    <section class="cv-section cv-competencies">
      <h2>Core Competencies</h2>
      <ul>
        {{#each competencies}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
    </section>
    {{/if}}

    {{#if achievements}}
    <section class="cv-section cv-achievements">
      <h2>Key Achievements</h2>
      <ul>
        {{#each achievements}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
    </section>
    {{/if}}

    {{#if experience}}
    <section class="cv-section">
      <h2>Professional Experience</h2>
      {{#each experience}}
      <article class="cv-entry">
        <div class="cv-entry-header">
          <h3>{{role}} — {{company}}</h3>
          <span class="dates">{{start}} – {{end}}</span>
        </div>
        {{#if location}}
        <div class="subtitle">{{location}}{{#if workmode}} · {{workmode}}{{/if}}</div>
        {{/if}}
        {{#if summary}}
        <p class="entry-summary">{{summary}}</p>
        {{/if}}
        {{#if highlights}}
        <ul>
          {{#each highlights}}
          <li>{{this}}</li>
          {{/each}}
        </ul>
        {{/if}}
      </article>
      {{/each}}
    </section>
    {{/if}}

    {{#if boardRoles}}
    <section class="cv-section">
      <h2>Board Roles &amp; Advisory</h2>
      {{#each boardRoles}}
      <article class="cv-entry">
        <div class="cv-entry-header">
          <h3>{{role}} — {{organisation}}</h3>
          <span class="dates">{{start}} – {{end}}</span>
        </div>
        {{#if description}}
        <div class="subtitle">{{description}}</div>
        {{/if}}
      </article>
      {{/each}}
    </section>
    {{/if}}

    {{#if volunteering}}
    <section class="cv-section">
      <h2>Volunteering</h2>
      {{#each volunteering}}
      <article class="cv-entry">
        <div class="cv-entry-header">
          <h3>{{role}} — {{organisation}}</h3>
          <span class="dates">{{start}} – {{end}}</span>
        </div>
        {{#if description}}
        <div class="subtitle">{{description}}</div>
        {{/if}}
      </article>
      {{/each}}
    </section>
    {{/if}}

    {{#if education}}
    <section class="cv-section">
      <h2>Education</h2>
      {{#each education}}
      <div class="cv-simple-entry">
        <div class="main-line">{{degree}}</div>
        <div class="detail-line">{{institution}}{{#if year}} — {{year}}{{/if}}</div>
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if certifications}}
    <section class="cv-section cv-competencies">
      <h2>Certifications</h2>
      <ul>
        {{#each certifications}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
    </section>
    {{/if}}

    {{#if languages}}
    <section class="cv-section cv-languages">
      <h2>Languages</h2>
      <ul>
        {{#each languages}}
        <li>{{language}} <span class="level">— {{level}}</span></li>
        {{/each}}
      </ul>
    </section>
    {{/if}}

    {{#if publications}}
    <section class="cv-section">
      <h2>Publications &amp; Speaking</h2>
      {{#each publications}}
      <div class="cv-simple-entry">
        <div class="main-line">{{title}}</div>
        <div class="detail-line">{{venue}}{{#if year}} — {{year}}{{/if}}{{#if type}} ({{type}}){{/if}}</div>
      </div>
      {{/each}}
    </section>
    {{/if}}
    {{#if interests}}
    <section class="cv-section cv-interests">
      <h2>Interests</h2>
      <ul>
        {{#each interests}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
    </section>
    {{/if}}
  </main>

  <button class="cv-download" onclick="window.print()">Download as PDF</button>

</body>
</html>
